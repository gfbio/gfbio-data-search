# Use an official Node runtime as a parent image
FROM node:20.9.0

# Set the working directory inside the container
WORKDIR /frontend

# Copy the manifest AND the lockfile, then install the exact locked tree.
# Installing from package-lock.json (npm ci) makes the image reproducible and
# prevents transitive-dependency drift from breaking the build. Keep in sync
# with package-lock.json.
COPY ./search/frontend/package.json ./search/frontend/package-lock.json ./
RUN npm ci

# Copy the Angular project files into the container
COPY ./search/frontend/ ./

# Expose the port the app runs on
EXPOSE 4200

# Define the command to run the app
CMD ["npm", "run", "start_dev"]
