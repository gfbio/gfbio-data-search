# Use Node.js version 20.9.0 as the base image
FROM node:20.9.0
ENV NODE_ENV=production

# Set the working directory in the container
WORKDIR /backend

# Copy package.json and package-lock.json first to leverage Docker layer caching
COPY ./backend/package*.json ./

# Install app dependencies reproducibly (production only)
RUN npm ci --omit=dev

# Copy the rest of the application code
COPY ./backend/ ./

# Expose the backend port (APP_PORT=3001 is supplied via .env at deploy time)
EXPOSE 3001

# Run the app directly with node (no nodemon in production)
CMD ["node", "server.js"]
